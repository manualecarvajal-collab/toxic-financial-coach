# Toxic Financial Coach - Variables de Entorno
# Copia este archivo como .env y completa los valores

# Gemini API Key (Obtenla gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Google Cloud TTS API Key (para voz masculina mexicana)
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto (o usa uno existente)
# 3. Habilita "Cloud Text-to-Speech API"
# 4. Ve a APIs & Services → Credentials → Create API Key
# 5. Pegala aqui:
# TTS_API_KEY=tu_tts_api_key_aqui

# Si no se configura, la app usará Web Speech API con tono grave como fallback

# VITE (opcional - si se deja vacío usa la URL relativa, funciona en dev y prod)
# VITE_API_URL=http://localhost:5173